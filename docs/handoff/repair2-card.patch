+      let res;
+      try { res = await withTimeout(p.eval(`__sw.batch(__ac, ${JSON.stringify(id)}, ${JSON.stringify(stepList)}, ${JSON.stringify(vars)}, ${JSON.stringify({ frames: o.frames || 0 })})`), 180000, `${lesson} ${size.id} ${mode} ${id}`); }
