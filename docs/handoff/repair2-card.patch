+    for (const k of m.controls || []) {
+      if ((k.overlapW > EPS && k.overlapH > EPS) || k.tapsInCard > 0) add('covers-' + k.kind, `${k.what} ${k.cover}% under the card (${k.tapsInCard}/${k.taps} taps land on it)`);
