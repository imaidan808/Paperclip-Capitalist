+      for (const m of res.cells) {
+        const faults = judge(m);
+        rows.push({ lesson, size: size.id, mode, state: m.state, step: m.step, variant: m.variant, shape: m.card ? m.card.cls : '-', card: m.card ? m.card.rect : null, faults });
