+  const v = m.view;
+  // --- where it stands
+  const R = c.rect;
+  if (R.x < -0.5 || R.y < -0.5 || R.x + R.w > v.w + 0.5 || R.y + R.h > v.h + 0.5) add('card-offscreen', `card ${R.x},${R.y} ${R.w}x${R.h} is not inside ${v.w}x${v.h}`);
