+    const t = m.target;
+    if (t && t.rect && t.via !== 'fallback' && t.rect.w * t.rect.h < 0.25 * v.w * v.h) {
+      const ox = Math.min(R.x + R.w, t.rect.x + t.rect.w) - Math.max(R.x, t.rect.x), oy = Math.min(R.y + R.h, t.rect.y + t.rect.h) - Math.max(R.y, t.rect.y);
